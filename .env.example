# Earl Minecraft connection
EARL_MC_HOST=localhost
EARL_MC_PORT=25565
EARL_MC_USERNAME=earl
EARL_MC_AUTH=offline
EARL_MC_VERSION=1.21.11

# Brain: ollama, hermes, or none
EARL_BRAIN=hermes

# Local body API
EARL_API_ENABLED=true
EARL_API_HOST=127.0.0.1
EARL_API_PORT=3001
EARL_API_URL=http://127.0.0.1:3001
# Required if EARL_API_HOST is not loopback
# EARL_API_TOKEN=replace-with-a-long-random-secret

# Durable bridge, task, and approved-procedure state (defaults under data/)
# EARL_DATA_DIR=C:\\Users\\you\\Documents\\earl\\data
# EARL_BRIDGE_FILE=
# EARL_TASKS_FILE=
# EARL_PROCEDURES_FILE=

# Optional per-launch Hermes override; otherwise use `hermes model`
# EARL_HERMES_PROVIDER=deepseek
# EARL_HERMES_MODEL=your-selected-model
# EARL_HERMES_YOLO=false

# Ollama mode only
EARL_OLLAMA_HOST=http://127.0.0.1:11434
EARL_OLLAMA_MODEL=qwen3:4b-instruct
EARL_OLLAMA_NUM_CTX=4096
